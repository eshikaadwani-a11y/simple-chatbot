# Supabase (public anon key is safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# LearnGraph backend (FastAPI on Railway, or http://localhost:8000 locally)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: comma-separated admin emails (shows the Admin analytics link)
NEXT_PUBLIC_ADMIN_EMAILS=
