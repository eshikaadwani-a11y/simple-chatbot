# ============================================================
# LearnGraph backend environment
# Copy to `.env` and fill in. Never commit the real .env.
# ============================================================

# ---- LLM provider keys ----
OPENAI_API_KEY=sk-...
# Optional alternate providers (only needed if you switch models)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Which model from app/agents/models.yaml to use by default.
LEARNGRAPH_DEFAULT_MODEL=gpt-5

# ---- Supabase ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...           # backend only, NEVER expose to browser
SUPABASE_JWT_SECRET=super-secret-jwt-secret # Project Settings -> API -> JWT Secret

# Postgres connection used by the LangGraph checkpointer (short-term memory).
# Supabase -> Project Settings -> Database -> Connection string (use the pooler).
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres

# ---- Tools (optional) ----
TAVILY_API_KEY=          # web_search; if empty, a deterministic stub is used
YOUTUBE_API_KEY=         # youtube_learning; if empty, a stub is used

# ---- Observability: LangSmith (optional) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=learngraph
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000
